NODE_ENV=production
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://client-finder.frel.cloud
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here
DATABASE_URL=

# ── Session ───────────────────────────────────────────────────────────────
# NEXTAUTH_SECRET dipakai sebagai kunci HS256 untuk cookie sesi (min. 32 char).
# Generate: openssl rand -base64 48
# SESSION_TTL_HOURS=12
# FORCE_SECURE_COOKIES=false

# ── Database ──────────────────────────────────────────────────────────────
# SQLite (default):  DATABASE_URL=file:data/clientfinder.db
# PostgreSQL:        DATABASE_URL=postgres://user:password@host:5432/clientfinder
# Turso:             DATABASE_URL=libsql://<db>.turso.io  + DATABASE_AUTH_TOKEN
# DATABASE_AUTH_TOKEN=
# DATABASE_SSL=true            # aktifkan TLS untuk Postgres terkelola
# DATABASE_POOL_MAX=10

# ── Bootstrap Superadmin (dibuat sekali saat database kosong) ─────────────
# Minimal 10 karakter. Jangan commit nilai asli ke repository.
SEED_SUPERADMIN_NAME=Superadmin
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_PASSWORD=

# ── Kuota Google Places API (hits per bulan) ──────────────────────────────
# Total platform (semua role) dan batas khusus role USER.
API_HIT_MONTHLY_LIMIT=5000
USER_MONTHLY_HIT_LIMIT=500

# ── Google Places (opsional) ──────────────────────────────────────────────
# Hanya untuk staging/test terhadap mock server; production biarkan kosong.
# GOOGLE_PLACES_API_BASE_URL=https://places.googleapis.com/v1
# PLACES_PAGE_DELAY_MS=2500
# PLACES_DETAILS_MAX=20
# PLACES_TIMEOUT_MS=20000

# ── Template WhatsApp ─────────────────────────────────────────────────────
# URL katalog yang disisipkan ke variabel {{catalog_url}}.
NEXT_PUBLIC_CATALOG_URL=https://client-finder.frel.cloud/katalog
