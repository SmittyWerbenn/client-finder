# ── Google Places API (New) ──────────────────────────────────────────────
# Ambil dari Google Cloud Console > APIs & Services > Credentials.
# Wajib mengaktifkan "Places API (New)" pada project Google Cloud.
GOOGLE_PLACES_API_KEY=

# ── Auth ─────────────────────────────────────────────────────────────────
# Password tunggal untuk masuk ke dashboard (studi kasus: admin/owner agency).
APP_ADMIN_PASSWORD=ubah-password-ini

# Secret untuk menandatangani JWT session (HS256). Minimal 32 karakter random.
# Generate: openssl rand -base64 48
SESSION_SECRET=ganti-dengan-string-random-minimal-32-karakter

# ── Opsional ─────────────────────────────────────────────────────────────
# Nama file JSON store di dalam folder ./data (default: db.json)
# DB_FILE_NAME=db.json
# Masa aktif session dalam jam (default: 12)
# SESSION_TTL_HOURS=12
# Paksa cookie Secure walau diakses via http (default: otomatis dari protokol)
# FORCE_SECURE_COOKIES=true
