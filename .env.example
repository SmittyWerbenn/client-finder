NODE_ENV=production
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://client-finder.frel.cloud
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here
DATABASE_URL=

# ── Session ───────────────────────────────────────────────────────────────
# NEXTAUTH_SECRET dipakai sebagai kunci HS256 untuk cookie sesi (min. 32 char).
# Generate: openssl rand -base64 48
# SESSION_TTL_HOURS=12
# FORCE_SECURE_COOKIES=false

# ── Database ──────────────────────────────────────────────────────────────
# SQLite (default):  DATABASE_URL=file:data/clientfinder.db
# PostgreSQL:        DATABASE_URL=postgres://user:password@host:5432/clientfinder
# Turso:             DATABASE_URL=libsql://<db>.turso.io  + DATABASE_AUTH_TOKEN
# DATABASE_AUTH_TOKEN=
# DATABASE_SSL=true            # aktifkan TLS untuk Postgres terkelola
# DATABASE_POOL_MAX=10

# ── Docker Compose (PostgreSQL) ───────────────────────────────────────────
# Hanya dipakai docker-compose.yml. Gunakan hex agar aman di URL koneksi:
#   openssl rand -hex 24
# Jangan diubah setelah volume pgdata dibuat.
POSTGRES_PASSWORD=

# ── Bootstrap Superadmin (dibuat sekali saat database kosong) ─────────────
# Minimal 10 karakter. Jangan commit nilai asli ke repository.
SEED_SUPERADMIN_NAME=Superadmin
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_PASSWORD=

# ── Kuota Google Places API (hits per bulan) ──────────────────────────────
# Total platform (semua role) dan batas khusus role USER.
API_HIT_MONTHLY_LIMIT=5000
USER_MONTHLY_HIT_LIMIT=500

# ── Google Places (opsional) ──────────────────────────────────────────────
# Hanya untuk staging/test terhadap mock server; production biarkan kosong.
# GOOGLE_PLACES_API_BASE_URL=https://places.googleapis.com/v1
# PLACES_PAGE_DELAY_MS=2500
# PLACES_DETAILS_MAX=20
# PLACES_TIMEOUT_MS=20000

# ── Template WhatsApp ─────────────────────────────────────────────────────
# URL katalog yang disisipkan ke variabel {{catalog_url}}.
NEXT_PUBLIC_CATALOG_URL=https://client-finder.frel.cloud/katalog

# ── DOKU Payment Gateway (DOKU Checkout, non-SNAP) ────────────────────────
# Isi dari DOKU Back Office → Integration → Client ID & Secret Key.
# Selama DOKU_CLIENT_ID / DOKU_SECRET_KEY kosong, tombol "Beli / Order"
# membalas 503 DOKU_NOT_CONFIGURED dan dialog checkout menawarkan
# penyelesaian manual via WhatsApp (order tetap tersimpan di tabel orders).
NEXT_PUBLIC_APP_URL=https://client-finder.frel.cloud
DOKU_CLIENT_ID=
DOKU_SECRET_KEY=
DOKU_IS_PRODUCTION=true
DOKU_CHECKOUT_URL_SANDBOX=https://api-sandbox.doku.com/checkout/v1/payment
DOKU_CHECKOUT_URL_PROD=https://api.doku.com/checkout/v1/payment

# Kontak support WhatsApp (aksi sekunder "Butuh bantuan / Tanya Admin").
NEXT_PUBLIC_ADMIN_WHATSAPP=6285778185971
